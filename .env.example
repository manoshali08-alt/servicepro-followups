# Copy to .env (never commit it). Used by docker compose and hosting dashboards.
APP_ENV=development            # "production" behind HTTPS (marks the session cookie Secure)
DATABASE_PATH=/data/servicepro.db
APP_TIMEZONE=Asia/Kolkata
# Creates the first admin on startup ONLY when no users exist. Remove ADMIN_PASSWORD after first login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-min-10-chars
